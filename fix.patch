+OTHER_LDFLAGS = $(inherited) -ObjC -l"CocoaLumberjack" -l"DCRoundSwitch" -l"Reachability" -l"iRate" -framework "QuartzCore" -framework "SystemConfiguration"
+PODS_BUILD_DIR = ${BUILD_DIR}
