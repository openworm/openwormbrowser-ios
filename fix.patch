-  <div class="section declaration table">
-    <div class="row"><div class="name cell">extern <a href="http://developer.apple.com/mac/library/documentation/Cocoa/Reference/Foundation/Classes/NSString_Class/Reference/NSString.html">NSString</a> * const <a href="#RKLICURegexEnumerationOptionsErrorKey">RKLICURegexEnumerationOptionsErrorKey</a>;</div></div>
