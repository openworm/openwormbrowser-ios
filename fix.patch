     NSMutableArray* returnArray = [[NSMutableArray alloc] initWithCapacity:NUMBER_OF_LAYERS];
     
     NSArray* layerList = [self remapDAGtoNodeName:[self getDAGForID:@1]];
     
     for(int i = 0; i < NUMBER_OF_LAYERS; i++)
