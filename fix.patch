-    <ul class="offset">
-      <li><a href="http://developer.apple.com/mac/library/documentation/Darwin/Reference/ManPages/man3/strtol.3.html" class="code">strtol(3)</a></li>
-      <li><a href="http://developer.apple.com/mac/library/documentation/Cocoa/Reference/Foundation/Classes/NSString_Class/Reference/NSString.html#//apple_ref/occ/instm/NSString/intValue" class="code">- intValue</a></li>
-      <li><a href="http://developer.apple.com/mac/library/documentation/Cocoa/Reference/Foundation/Classes/NSString_Class/Reference/NSString.html#//apple_ref/occ/instm/NSString/doubleValue" class="code">- doubleValue</a></li>
